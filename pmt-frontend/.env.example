VITE_API_URL=http://localhost:5000/api
# Optional. In production, point this at the backend's WebSocket endpoint.
# If omitted, the frontend derives it from VITE_API_URL.
VITE_WS_URL=
VITE_CLIENT_URL=http://localhost:5173
# Public Pusher Channels app key and cluster; set these in the frontend build environment
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
